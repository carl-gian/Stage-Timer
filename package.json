{
  "name": "stagetimer",
  "version": "1.0.0",
  "description": "Meeting stage timer with OBS dock and web control",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node src/cli.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Stage Timer",
  "build": {
    "appId": "com.stagetimer.app",
    "productName": "Stage Timer",
    "files": [
      "src/**",
      "web/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Stage-Timer-Setup-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carl-gian/Stage-Timer.git"
  }
}
